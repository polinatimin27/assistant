<Window x:Class="assistant.CoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant"
        Width="900"
        Height="760"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#050914"
        Loaded="CoreWindow_Loaded"
        Closed="CoreWindow_Closed">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Orbit1Rotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360"
                                     Duration="0:0:48"
                                     RepeatBehavior="Forever"/>

                    <DoubleAnimation Storyboard.TargetName="Orbit2Rotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="55" To="415"
                                     Duration="0:1:02"
                                     RepeatBehavior="Forever"/>

                    <DoubleAnimation Storyboard.TargetName="Orbit3Rotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="125" To="485"
                                     Duration="0:1:16"
                                     RepeatBehavior="Forever"/>

                    <DoubleAnimation Storyboard.TargetName="Orbit4Rotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="40" To="400"
                                     Duration="0:1:30"
                                     RepeatBehavior="Forever"/>

                    <DoubleAnimation Storyboard.TargetName="ModuleSpin"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360"
                                     Duration="0:0:14"
                                     RepeatBehavior="Forever"/>

                    <DoubleAnimation Storyboard.TargetName="CorePulse"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.025"
                                     Duration="0:0:5"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever"/>

                    <DoubleAnimation Storyboard.TargetName="CorePulse"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.025"
                                     Duration="0:0:5"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#142D55" Offset="0"/>
                <GradientStop Color="#091426" Offset="0.58"/>
                <GradientStop Color="#050914" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Viewbox Width="620"
                 Height="620"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid Width="600" Height="600">

                <!-- Первая широкая орбита -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="Orbit1Rotation"
                                         Angle="0"/>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="58"
                             Canvas.Top="166"
                             Width="484"
                             Height="268"
                             Fill="Transparent"
                             Stroke="#377AA8"
                             StrokeThickness="1.3"
                             Opacity="0.30"/>

                    <Ellipse Canvas.Left="58"
                             Canvas.Top="166"
                             Width="484"
                             Height="268"
                             Fill="Transparent"
                             Stroke="#26AFFF"
                             StrokeThickness="2.6"
                             StrokeDashArray="18 145"
                             Opacity="0.85">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#168BFF"
                                              BlurRadius="15"
                                              ShadowDepth="0"
                                              Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Ellipse Canvas.Left="291"
                             Canvas.Top="157"
                             Width="18"
                             Height="18"
                             Fill="#102B4A"
                             Stroke="#A5ECFF"
                             StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#29AFFF"
                                              BlurRadius="15"
                                              ShadowDepth="0"
                                              Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- Вторая, более вертикальная орбита -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="0.88"/>
                            <RotateTransform x:Name="Orbit2Rotation"
                                             Angle="55"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="148"
                             Canvas.Top="60"
                             Width="304"
                             Height="480"
                             Fill="Transparent"
                             Stroke="#3979A5"
                             StrokeThickness="1.2"
                             Opacity="0.27"/>

                    <Ellipse Canvas.Left="148"
                             Canvas.Top="60"
                             Width="304"
                             Height="480"
                             Fill="Transparent"
                             Stroke="#27A7F5"
                             StrokeThickness="2.4"
                             StrokeDashArray="18 160"
                             Opacity="0.78">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#168BFF"
                                              BlurRadius="14"
                                              ShadowDepth="0"
                                              Opacity="0.75"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Ellipse Canvas.Left="293"
                             Canvas.Top="52"
                             Width="14"
                             Height="14"
                             Fill="#0D2440"
                             Stroke="#8EDFFF"
                             StrokeThickness="2"/>
                </Canvas>

                <!-- Третья наклонная орбита -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="0.82"/>
                            <RotateTransform x:Name="Orbit3Rotation"
                                             Angle="125"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="68"
                             Canvas.Top="105"
                             Width="464"
                             Height="390"
                             Fill="Transparent"
                             Stroke="#397CB5"
                             StrokeThickness="1.2"
                             Opacity="0.24"/>

                    <Ellipse Canvas.Left="68"
                             Canvas.Top="105"
                             Width="464"
                             Height="390"
                             Fill="Transparent"
                             Stroke="#259EFF"
                             StrokeThickness="2.5"
                             StrokeDashArray="20 180"
                             Opacity="0.74">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#168BFF"
                                              BlurRadius="14"
                                              ShadowDepth="0"
                                              Opacity="0.75"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Маленький вращающийся элемент -->
                    <Canvas Canvas.Left="438"
                            Canvas.Top="139"
                            Width="34"
                            Height="34"
                            RenderTransformOrigin="0.5,0.5">

                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="ModuleSpin"/>
                        </Canvas.RenderTransform>

                        <Ellipse Canvas.Left="2"
                                 Canvas.Top="2"
                                 Width="30"
                                 Height="30"
                                 Fill="#0A1930"
                                 Stroke="#64C7FF"
                                 StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#168BFF"
                                                  BlurRadius="14"
                                                  ShadowDepth="0"
                                                  Opacity="0.85"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Ellipse Canvas.Left="8"
                                 Canvas.Top="8"
                                 Width="18"
                                 Height="18"
                                 Fill="Transparent"
                                 Stroke="#A0E9FF"
                                 StrokeThickness="1.5"
                                 StrokeDashArray="5 4"/>

                        <Ellipse Canvas.Left="14"
                                 Canvas.Top="14"
                                 Width="6"
                                 Height="6"
                                 Fill="#8BE4FF"/>
                    </Canvas>
                </Canvas>

                <!-- Четвёртая, дальняя орбита -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="0.88"/>
                            <RotateTransform x:Name="Orbit4Rotation"
                                             Angle="40"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="117"
                             Canvas.Top="91"
                             Width="366"
                             Height="418"
                             Fill="Transparent"
                             Stroke="#356D96"
                             StrokeThickness="1.1"
                             Opacity="0.19"/>

                    <Ellipse Canvas.Left="117"
                             Canvas.Top="91"
                             Width="366"
                             Height="418"
                             Fill="Transparent"
                             Stroke="#398FD0"
                             StrokeThickness="2"
                             StrokeDashArray="15 220"
                             Opacity="0.56">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#168BFF"
                                              BlurRadius="11"
                                              ShadowDepth="0"
                                              Opacity="0.65"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Ellipse Canvas.Left="293"
                             Canvas.Top="83"
                             Width="12"
                             Height="12"
                             Fill="#102A45"
                             Stroke="#72C9F2"
                             StrokeThickness="1.7"/>
                </Canvas>

                <!-- Подложка закрывает прозрачные места текстуры ядра -->
                <Path x:Name="CoreBaseShape"
                      Width="280"
                      Height="280"
                      Stretch="None"
                      Fill="#168CF5"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="1.06"
                                        ScaleY="1.06"/>
                    </Path.RenderTransform>
                </Path>

                <!-- Ядро -->
                <Path x:Name="CoreShape"
                      Width="280"
                      Height="280"
                      Stretch="None"
                      Stroke="#A5E8FF"
                      StrokeThickness="2"
                      RenderTransformOrigin="0.5,0.5"
                      Cursor="Hand"
                      MouseLeftButtonUp="Core_MouseLeftButtonUp">

                    <Path.Fill>
                        <ImageBrush ImageSource="/CoreIdle.png"
                                    Stretch="Fill"
                                    Viewbox="0.14,0.14,0.72,0.72"
                                    ViewboxUnits="RelativeToBoundingBox"/>
                    </Path.Fill>

                    <Path.RenderTransform>
                        <ScaleTransform x:Name="CorePulse"/>
                    </Path.RenderTransform>

                    <Path.Effect>
                        <DropShadowEffect Color="#29AFFF"
                                          BlurRadius="38"
                                          ShadowDepth="0"
                                          Opacity="0.9"/>
                    </Path.Effect>
                </Path>

            </Grid>
        </Viewbox>
    </Grid>
</Window>