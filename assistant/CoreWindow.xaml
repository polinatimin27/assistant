<Window x:Class="assistant.CoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant"
        Width="900"
        Height="760"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#050914"
        Loaded="CoreWindow_Loaded"
        Closed="CoreWindow_Closed">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>

                    <!-- Основные кольца -->
                    <DoubleAnimation
                        Storyboard.TargetName="OrbitImageRotation1"
                        Storyboard.TargetProperty="Angle"
                        From="0" To="360"
                        Duration="0:0:52"
                        RepeatBehavior="Forever"/>

                    <DoubleAnimation
                        Storyboard.TargetName="OrbitImageRotation2"
                        Storyboard.TargetProperty="Angle"
                        From="360" To="0"
                        Duration="0:1:10"
                        RepeatBehavior="Forever"/>

                    <!-- Дальний почти невидимый слой -->
                    <DoubleAnimation
                        Storyboard.TargetName="OrbitImageRotation3"
                        Storyboard.TargetProperty="Angle"
                        From="0" To="360"
                        Duration="0:1:40"
                        RepeatBehavior="Forever"/>

                    <DoubleAnimation
                        Storyboard.TargetName="OrbitImage3"
                        Storyboard.TargetProperty="Opacity"
                        From="0.07" To="0.14"
                        Duration="0:0:12"
                        AutoReverse="True"
                        RepeatBehavior="Forever"/>

                    <!-- Дополнительные орбиты -->
                    <DoubleAnimation
                        Storyboard.TargetName="ExtraOrbit1Rotation"
                        Storyboard.TargetProperty="Angle"
                        From="0" To="360"
                        Duration="0:0:40"
                        RepeatBehavior="Forever"/>

                    <DoubleAnimation
                        Storyboard.TargetName="ExtraOrbit2Rotation"
                        Storyboard.TargetProperty="Angle"
                        From="360" To="0"
                        Duration="0:0:50"
                        RepeatBehavior="Forever"/>

                    <DoubleAnimation
                        Storyboard.TargetName="ExtraOrbit3Rotation"
                        Storyboard.TargetProperty="Angle"
                        From="0" To="360"
                        Duration="0:1:00"
                        RepeatBehavior="Forever"/>

                    <DoubleAnimation
                        Storyboard.TargetName="ExtraOrbit4Rotation"
                        Storyboard.TargetProperty="Angle"
                        From="360" To="0"
                        Duration="0:1:12"
                        RepeatBehavior="Forever"/>

                    <!-- Внешняя дымка -->
                    <DoubleAnimation
                        Storyboard.TargetName="MistOrbit1Rotation"
                        Storyboard.TargetProperty="Angle"
                        From="0" To="360"
                        Duration="0:1:25"
                        RepeatBehavior="Forever"/>

                    <DoubleAnimation
                        Storyboard.TargetName="MistOrbit2Rotation"
                        Storyboard.TargetProperty="Angle"
                        From="360" To="0"
                        Duration="0:1:45"
                        RepeatBehavior="Forever"/>

                    <!-- Плавное изменение яркости -->
                    <DoubleAnimation
                        Storyboard.TargetName="OrbitImage1"
                        Storyboard.TargetProperty="Opacity"
                        From="0.90" To="1"
                        Duration="0:0:7"
                        AutoReverse="True"
                        RepeatBehavior="Forever"/>

                    <DoubleAnimation
                        Storyboard.TargetName="OrbitImage2"
                        Storyboard.TargetProperty="Opacity"
                        From="0.32" To="0.50"
                        Duration="0:0:9"
                        AutoReverse="True"
                        RepeatBehavior="Forever"/>

                    <!-- Пульсация ядра -->
                    <DoubleAnimation
                        Storyboard.TargetName="CorePulse"
                        Storyboard.TargetProperty="ScaleX"
                        From="1" To="1.025"
                        Duration="0:0:5"
                        AutoReverse="True"
                        RepeatBehavior="Forever"/>

                    <DoubleAnimation
                        Storyboard.TargetName="CorePulse"
                        Storyboard.TargetProperty="ScaleY"
                        From="1" To="1.025"
                        Duration="0:0:5"
                        AutoReverse="True"
                        RepeatBehavior="Forever"/>

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#142D55" Offset="0"/>
                <GradientStop Color="#091426" Offset="0.58"/>
                <GradientStop Color="#050914" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Viewbox Width="620"
                 Height="620"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid Width="600" Height="600">

                <!-- Дальний слабый слой, как испарение -->
                <Image x:Name="OrbitImage3"
                       Source="/OrbitRings.png"
                       Width="920"
                       Height="920"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Opacity="0.10"
                       RenderTransformOrigin="0.5,0.5">

                    <Image.Effect>
                        <BlurEffect Radius="5"/>
                    </Image.Effect>

                    <Image.RenderTransform>
                        <RotateTransform
                            x:Name="OrbitImageRotation3"
                            Angle="0"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Первый слой энергетических колец -->
                <Image x:Name="OrbitImage1"
                       Source="/OrbitRings.png"
                       Width="700"
                       Height="700"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Opacity="1"
                       RenderTransformOrigin="0.5,0.5">

                    <Image.RenderTransform>
                        <RotateTransform
                            x:Name="OrbitImageRotation1"
                            Angle="0"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Второй слой энергетических колец -->
                <Image x:Name="OrbitImage2"
                       Source="/OrbitRings.png"
                       Width="740"
                       Height="740"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Opacity="0.42"
                       RenderTransformOrigin="0.5,0.5">

                    <Image.RenderTransform>
                        <RotateTransform
                            x:Name="OrbitImageRotation2"
                            Angle="0"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Внешняя еле заметная дымка-орбита 1 -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <RotateTransform
                            x:Name="MistOrbit1Rotation"
                            Angle="0"/>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="10"
                             Canvas.Top="50"
                             Width="580"
                             Height="500"
                             Fill="Transparent"
                             Stroke="#62BFFF"
                             StrokeThickness="1.1"
                             Opacity="0.06">
                        <Ellipse.Effect>
                            <BlurEffect Radius="2"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- Внешняя еле заметная дымка-орбита 2 -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="0.90"/>
                            <RotateTransform
                                x:Name="MistOrbit2Rotation"
                                Angle="35"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="0"
                             Canvas.Top="35"
                             Width="600"
                             Height="530"
                             Fill="Transparent"
                             Stroke="#7ACDFF"
                             StrokeThickness="0.9"
                             Opacity="0.05">
                        <Ellipse.Effect>
                            <BlurEffect Radius="2"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- Орбита 1 -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <RotateTransform
                            x:Name="ExtraOrbit1Rotation"
                            Angle="0"/>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="40"
                             Canvas.Top="86"
                             Width="520"
                             Height="430"
                             Fill="Transparent"
                             Stroke="#2A86D7"
                             StrokeThickness="1.2"
                             Opacity="0.21"/>

                    <Ellipse Canvas.Left="294.5"
                             Canvas.Top="80.5"
                             Width="11"
                             Height="11"
                             Fill="#F0FCFF">
                        <Ellipse.Effect>
                            <DropShadowEffect
                                Color="#80DFFF"
                                BlurRadius="15"
                                ShadowDepth="0"
                                Opacity="0.92"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- Орбита 2 -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="0.88"/>
                            <RotateTransform
                                x:Name="ExtraOrbit2Rotation"
                                Angle="45"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="78"
                             Canvas.Top="55"
                             Width="444"
                             Height="490"
                             Fill="Transparent"
                             Stroke="#2B7FD1"
                             StrokeThickness="1.1"
                             Opacity="0.18"/>

                    <Ellipse Canvas.Left="294"
                             Canvas.Top="49"
                             Width="12"
                             Height="12"
                             Fill="#F0FCFF">
                        <Ellipse.Effect>
                            <DropShadowEffect
                                Color="#80DFFF"
                                BlurRadius="15"
                                ShadowDepth="0"
                                Opacity="0.92"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- Орбита 3 -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="0.84"/>
                            <RotateTransform
                                x:Name="ExtraOrbit3Rotation"
                                Angle="120"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="48"
                             Canvas.Top="78"
                             Width="504"
                             Height="446"
                             Fill="Transparent"
                             Stroke="#3A97EA"
                             StrokeThickness="1"
                             Opacity="0.15"/>

                    <Ellipse Canvas.Left="295"
                             Canvas.Top="73"
                             Width="10"
                             Height="10"
                             Fill="#F0FCFF">
                        <Ellipse.Effect>
                            <DropShadowEffect
                                Color="#80DFFF"
                                BlurRadius="15"
                                ShadowDepth="0"
                                Opacity="0.92"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- Орбита 4 -->
                <Canvas Width="600"
                        Height="600"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="0.92"/>
                            <RotateTransform
                                x:Name="ExtraOrbit4Rotation"
                                Angle="200"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="65"
                             Canvas.Top="68"
                             Width="470"
                             Height="458"
                             Fill="Transparent"
                             Stroke="#2A75BE"
                             StrokeThickness="1"
                             Opacity="0.14"/>

                    <Ellipse Canvas.Left="294.5"
                             Canvas.Top="62.5"
                             Width="11"
                             Height="11"
                             Fill="#F0FCFF">
                        <Ellipse.Effect>
                            <DropShadowEffect
                                Color="#80DFFF"
                                BlurRadius="15"
                                ShadowDepth="0"
                                Opacity="0.92"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <!-- Подложка ядра -->
                <Path x:Name="CoreBaseShape"
                      Width="280"
                      Height="280"
                      Stretch="None"
                      Fill="#168CF5"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">

                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="1.06"
                                        ScaleY="1.06"/>
                    </Path.RenderTransform>
                </Path>

                <!-- Ядро -->
                <Path x:Name="CoreShape"
                      Width="280"
                      Height="280"
                      Stretch="None"
                      Stroke="#A5E8FF"
                      StrokeThickness="2"
                      RenderTransformOrigin="0.5,0.5"
                      Cursor="Hand"
                      MouseLeftButtonUp="Core_MouseLeftButtonUp">

                    <Path.Fill>
                        <ImageBrush ImageSource="/CoreIdle.png"
                                    Stretch="Fill"
                                    Viewbox="0.14,0.14,0.72,0.72"
                                    ViewboxUnits="RelativeToBoundingBox"/>
                    </Path.Fill>

                    <Path.RenderTransform>
                        <ScaleTransform x:Name="CorePulse"/>
                    </Path.RenderTransform>

                    <Path.Effect>
                        <DropShadowEffect Color="#29AFFF"
                                          BlurRadius="38"
                                          ShadowDepth="0"
                                          Opacity="0.9"/>
                    </Path.Effect>
                </Path>

            </Grid>
        </Viewbox>
    </Grid>
</Window>