<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="CoreFrames.png" />
    <None Remove="CoreIdle.png" />
    <None Remove="MainLogo.png" />
    <None Remove="MainWaves.png" />
    <None Remove="OrbitRings.png" />
    <None Remove="WaveHighlights.png" />
    <None Remove="Themes\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="CoreFrames.png" />
    <Resource Include="CoreIdle.png" />
    <Resource Include="MainLogo.png" />
    <Resource Include="MainWaves.png" />
    <Resource Include="OrbitRings.png" />
    <Resource Include="WaveHighlights.png" />
    <Resource Include="Themes\**\*.png" />
  </ItemGroup>

</Project>
