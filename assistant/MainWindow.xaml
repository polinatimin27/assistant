<Window x:Class="assistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant"
        Width="1100"
        Height="720"
        MinWidth="850"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#080E1B">

    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1B2B47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Grid.Column="0"
                Background="#0D1729"
                BorderBrush="#1C2A40"
                BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="58"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="ASSISTANT"
                           Foreground="#78B7FF"
                           FontSize="19"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Grid.Row="1"
                        Content="Ассистенты"
                        Style="{StaticResource MenuButton}"/>

                <Button Grid.Row="2"
                        Content="История команд"
                        Style="{StaticResource MenuButton}"/>

                <Button Grid.Row="4"
                        Content="⚙  Настройки"
                        Style="{StaticResource MenuButton}"/>

                <Button Grid.Row="5"
                        Content="◉  Профиль"
                        Style="{StaticResource MenuButton}"/>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0B1424"
                    BorderBrush="#1C2A40"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Главное окно"
                               Foreground="#EAF2FF"
                               FontSize="21"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="RU"
                            Width="48"
                            Height="38"
                            Margin="0,0,12,0"
                            Foreground="#EAF2FF"
                            Background="#172640"
                            BorderBrush="#304767"
                            BorderThickness="1"
                            Cursor="Hand"/>

                    <Border Grid.Column="2"
                            Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#2588FF"
                            BorderBrush="#8CC8FF"
                            BorderThickness="1"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Выбери ассистента"
                               Foreground="#EAF2FF"
                               FontSize="30"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Здесь появится список доступных ассистентов"
                               Foreground="#91A5C2"
                               FontSize="16"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>