<Window x:Class="assistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant"
        Width="1300" Height="820"
        MinWidth="900" MinHeight="610"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        WindowState="Maximized"
        Background="#020611"
        FontFamily="Segoe UI"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed">

    <Window.Resources>
        <Style x:Key="NavStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#EDF6FF"/>
            <Setter Property="Background" Value="#061834"/>
            <Setter Property="BorderBrush" Value="#167BDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="16,0,16,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Panel" CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Panel" Property="Background" Value="#123970"/>
                                <Setter TargetName="Panel" Property="BorderBrush" Value="#4DC0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Panel" Property="Background" Value="#2159A4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconOnlyStyle" TargetType="Button">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Panel" Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Panel" Property="Background" Value="#173C79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrbButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Background" Value="#031B49"/>
            <Setter Property="BorderBrush" Value="#368DFF"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Foreground" Value="#F4FAFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Background="{TemplateBinding Background}"
                                CornerRadius="15" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#1582FF" Opacity="0.65"
                                                  BlurRadius="16" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#174E94"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Width" Value="53"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Foreground" Value="#E5F2FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="#1B4383"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="5" Background="#040E21" CornerRadius="17"
            BorderThickness="1.5" BorderBrush="#1176DB" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="67"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" Background="#05142D"
                    BorderBrush="#175FBA" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,0"
                                VerticalAlignment="Center">
                        <Image Source="/MainLogo.png" Width="49" Height="49"
                               Stretch="Uniform"/>
                        <TextBlock Text="Assistant" Margin="13,0,0,0"
                                   VerticalAlignment="Center" FontSize="25"
                                   Foreground="#F2F7FF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowControlStyle}" Content="−"
                                Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowControlStyle}" Content="□"
                                Click="Maximize_Click"/>
                        <Button Style="{StaticResource WindowControlStyle}" Content="×"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="285"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель -->
                <Border Grid.Column="0" Margin="0,0,0,0"
                        Background="#031127"
                        BorderBrush="#217CE4" BorderThickness="0,0,1.5,0"
                        CornerRadius="0,17,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="49"/>
                            <RowDefinition Height="76"/>
                            <RowDefinition Height="76"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="78"/>
                        </Grid.RowDefinitions>

                        <!-- Ассистенты -->
                        <Button x:Name="AssistantsButton" Grid.Row="1"
                                Style="{StaticResource NavStyle}"
                                Background="#0D3677" BorderBrush="#5BCCFF"
                                Click="Assistants_Click">
                            <StackPanel Orientation="Horizontal" Margin="17,0">
                                <TextBlock Text="▣" FontFamily="Segoe UI Symbol"
                                           FontSize="27" Foreground="#87CEFF"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="AssistantsText" Text="Ассистенты"
                                           Foreground="White" Margin="17,0,0,0"
                                           VerticalAlignment="Center" FontSize="16"/>
                            </StackPanel>
                        </Button>

                        <!-- История команд -->
                        <Button x:Name="HistoryButton" Grid.Row="2"
                                Style="{StaticResource NavStyle}"
                                Click="History_Click">
                            <StackPanel Orientation="Horizontal" Margin="17,0">
                                <TextBlock Text="◷" FontFamily="Segoe UI Symbol"
                                           FontSize="30" Foreground="#B8DAFF"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="HistoryText" Text="История команд"
                                           Foreground="White" Margin="17,0,0,0"
                                           VerticalAlignment="Center" FontSize="16"/>
                            </StackPanel>
                        </Button>

                        <!-- Настройки -->
                        <Button Grid.Row="4" Margin="24,0,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource IconOnlyStyle}"
                                ToolTip="Настройки" Click="Settings_Click">
                            <TextBlock Text="⚙" FontFamily="Segoe UI Symbol"
                                       FontSize="42" Foreground="#D5E8FF"/>
                        </Button>

                        <!-- Профиль -->
                        <Button Grid.Row="5" Margin="24,0,0,12"
                                HorizontalAlignment="Left"
                                Style="{StaticResource IconOnlyStyle}"
                                ToolTip="Профиль" Click="Profile_Click">
                            <Viewbox Width="39" Height="43">
                                <Canvas Width="40" Height="45">
                                    <Ellipse Canvas.Left="12" Canvas.Top="3"
                                             Width="16" Height="16"
                                             Stroke="#D9E9FF" StrokeThickness="2.5"/>
                                    <Path Data="M 2,41 C 2,18 38,18 38,41 Z"
                                          Stroke="#D9E9FF" StrokeThickness="2.5"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- Основной фон -->
                <Grid Grid.Column="1" ClipToBounds="True"
                      Background="#030B1F" x:Name="Workspace">

                    <Image Source="/MainWaves.png" Stretch="UniformToFill"
                           IsHitTestVisible="False"/>

                    <!-- Плавно движущиеся световые линии -->
                    <Image Source="/WaveHighlights.png" Stretch="UniformToFill"
                           Opacity="0.40" IsHitTestVisible="False"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                <SkewTransform x:Name="WaveSkew" AngleY="0"/>
                                <TranslateTransform x:Name="WaveShift"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Живые волны -->
                    <Canvas x:Name="WaveOverlay" IsHitTestVisible="False"
                            Opacity="0.20" ClipToBounds="True"/>

                    <!-- Нажатие на волны открывает ядро -->
                    <Viewbox Stretch="UniformToFill" StretchDirection="Both">
                        <Canvas Width="1344" Height="836">
                            <Path Data="M 320,836
                                        C 550,720 710,580 900,420
                                        C 1080,265 1130,85 1240,0
                                        L 1344,0 1344,836 Z"
                                  Fill="Transparent" StrokeThickness="0"
                                  Cursor="Hand" ToolTip="Открыть ядро Джарвиса"
                                  MouseLeftButtonUp="WaveArea_MouseLeftButtonUp"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Язык и тема -->
                    <Viewbox Stretch="UniformToFill" StretchDirection="Both">
                        <Canvas Width="1344" Height="836">

                            <!-- Язык: поднят выше -->
                            <Button x:Name="LanguageButton"
                                    Canvas.Left="1193" Canvas.Top="35"
                                    Style="{StaticResource OrbButtonStyle}"
                                    ToolTip="Язык / Language"
                                    Click="Language_Click">
                                <Grid Width="17" Height="17">
                                    <Ellipse Stroke="#F1F8FF" StrokeThickness="1.3"/>
                                    <Ellipse Stroke="#F1F8FF" StrokeThickness="1.1"
                                             Margin="5,0"/>
                                    <Line X1="0" Y1="8.5" X2="17" Y2="8.5"
                                          Stroke="#F1F8FF" StrokeThickness="1.4"/>
                                </Grid>
                            </Button>

                            <!-- Тема: поднята выше, расстояние прежнее -->
                            <Button x:Name="ThemeButton"
                                    Canvas.Left="1193" Canvas.Top="74"
                                    Style="{StaticResource OrbButtonStyle}"
                                    ToolTip="Цветовая тема"
                                    Click="Theme_Click">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="25" Height="25">
                                        <Path Data="M 12.5,2 C 6.4,2 2,6.4 2,12.5
                                                    C 2,18.8 6.5,23 12.5,23
                                                    C 15.2,23 17,21.1 16,18.7
                                                    C 15.4,17.1 16.5,15.7 18.1,15.7
                                                    C 21.1,15.7 23,13.4 23,10.8
                                                    C 23,5.7 18.3,2 12.5,2 Z"
                                              Fill="#0A2553" Stroke="#D6EDFF"
                                              StrokeThickness="1.5"/>
                                        <Ellipse Canvas.Left="7" Canvas.Top="5.5"
                                                 Width="4" Height="4" Fill="#7EDBFF"/>
                                        <Ellipse Canvas.Left="14" Canvas.Top="5.5"
                                                 Width="4" Height="4" Fill="#B19AFF"/>
                                        <Ellipse Canvas.Left="5" Canvas.Top="12"
                                                 Width="4" Height="4" Fill="#76D8C8"/>
                                        <Ellipse Canvas.Left="10.5" Canvas.Top="15"
                                                 Width="4" Height="4" Fill="#E8ADFF"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Canvas>
                    </Viewbox>

                    <!-- Панель разделов -->
                    <Border x:Name="SectionPanel" Visibility="Collapsed"
                            Width="440" MaxWidth="440" Padding="25"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#E6091C3B" BorderBrush="#398BEA"
                            BorderThickness="1" CornerRadius="18">
                        <StackPanel>
                            <TextBlock x:Name="SectionTitle" FontSize="26"
                                       Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SectionInfo" FontSize="15"
                                       Margin="0,12,0,10" TextWrapping="Wrap"
                                       Foreground="#B9CEE9"/>
                            <StackPanel x:Name="AssistantChoices" Visibility="Collapsed"
                                        Margin="0,15,0,0">
                                <Button Content="Джарвис — открыть ядро"
                                        Height="48" Margin="0,0,0,10"
                                        Background="#0E3976" Foreground="White"
                                        BorderBrush="#4A9BF4" Cursor="Hand"
                                        Click="OpenJarvis_Click"/>
                                <Button Content="Ян — выбрать ассистента"
                                        Height="48" Background="#0E3976"
                                        Foreground="White" BorderBrush="#4A9BF4"
                                        Cursor="Hand" Click="ChooseJan_Click"/>
                            </StackPanel>
                            <Button Content="Закрыть" Width="95" Height="32"
                                    HorizontalAlignment="Right" Margin="0,18,0,0"
                                    Background="#152C4F" Foreground="#DCEEFF"
                                    BorderBrush="#4479B7" Click="HidePanel_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
